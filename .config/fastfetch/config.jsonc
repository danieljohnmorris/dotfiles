{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/nvim/assets/tachikoma.png",
    "width": 40,
    "padding": {
      "top": 2,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    { "type": "host",    "key": " PC",   "keyColor": "green" },
    { "type": "cpu",     "key": "│ ├",  "showPeCoreCount": true, "keyColor": "green" },
    { "type": "gpu",     "key": "│ ├",  "detectionMethod": "pci", "keyColor": "green" },
    { "type": "display", "key": "│ ├󱄄", "keyColor": "green" },
    { "type": "disk",    "key": "│ ├󰋊", "keyColor": "green" },
    { "type": "memory",  "key": "│ ├",  "keyColor": "green" },
    { "type": "swap",    "key": "└ └󰓡 ", "keyColor": "green" },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    { "type": "os",           "key": " OS",  "keyColor": "blue" },
    { "type": "kernel",       "key": "│ ├",       "keyColor": "blue" },
    { "type": "wm",           "key": "│ ├",       "keyColor": "blue" },
    { "type": "de",           "key": " DE",       "keyColor": "blue" },
    { "type": "shell",        "key": "│ ├",       "keyColor": "blue" },
    { "type": "terminal",     "key": "│ ├",       "keyColor": "blue" },
    { "type": "packages",     "key": "│ ├󰏖",       "keyColor": "blue" },
    { "type": "terminalfont", "key": "└ └",       "keyColor": "blue" },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Colors───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(( (current - birth_install) / 86400 )); echo \"$days days\""
    },
    { "type": "uptime", "key": "󱫐 Uptime", "keyColor": "magenta" },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
    {
      "type": "custom",
      "format": "\u001b[90m├────────────────────Rice Stack──────────────────────┤"
    },
    {
      "type": "command",
      "key": "󰖯 Compositor",
      "keyColor": "yellow",
      "text": "echo 'Hyprland'"
    },
    {
      "type": "command",
      "key": "│ ├󰃖 Shell",
      "keyColor": "yellow",
      "text": "systemctl --user is-active dms &>/dev/null && echo 'DankMaterialShell (Quickshell)' || { pgrep -x waybar &>/dev/null && echo 'Waybar'; } || echo 'none'"
    },
    {
      "type": "command",
      "key": "│ ├󰍩 Notifs",
      "keyColor": "yellow",
      "text": "pgrep -x swaync &>/dev/null && echo 'swaync' || { pgrep -x mako &>/dev/null && echo 'mako'; } || { systemctl --user is-active dms &>/dev/null && echo 'dms (built-in)'; } || echo 'none'"
    },
    {
      "type": "command",
      "key": "│ ├󰍉 Launcher",
      "keyColor": "yellow",
      "text": "command -v walker &>/dev/null && echo 'Walker' || { command -v rofi &>/dev/null && echo 'rofi'; } || echo 'none'"
    },
    {
      "type": "command",
      "key": "│ ├󰸉 Wallpaper",
      "keyColor": "yellow",
      "text": "awww query 2>/dev/null | head -1 | sed 's|.*image: ||;s|.*/||' || echo 'none'"
    },
    {
      "type": "command",
      "key": "│ ├󰸌 Theming",
      "keyColor": "yellow",
      "text": "command -v matugen &>/dev/null && echo 'matugen (Material You)' || echo 'static'"
    },
    {
      "type": "command",
      "key": "│ ├󰌾 Lock",
      "keyColor": "yellow",
      "text": "command -v hyprlock &>/dev/null && echo 'hyprlock' || echo 'none'"
    },
    {
      "type": "command",
      "key": "└ └ Login",
      "keyColor": "yellow",
      "text": "systemctl is-enabled sddm &>/dev/null && echo 'SDDM' || echo 'tty'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
